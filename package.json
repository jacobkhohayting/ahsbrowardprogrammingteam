{
  "name": "ahs-contests",
  "version": "1.0.0",
  "private": true,
  "description": "A Codeforces-style contest site with a built-in judge for C++, Python and Java, made to run on Vercel.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --disable-warning=ExperimentalWarning --experimental-strip-types --test \"tests/*.test.mjs\"",
    "sync-runner": "node scripts/sync-runner.mjs"
  },
  "dependencies": {
    "@codemirror/commands": "^6.8.1",
    "@codemirror/lang-cpp": "^6.0.3",
    "@codemirror/lang-java": "^6.0.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/language": "^6.11.0",
    "@codemirror/state": "^6.5.2",
    "@codemirror/view": "^6.38.0",
    "@fontsource-variable/recursive": "^5.3.0",
    "@lezer/highlight": "^1.2.5",
    "@vercel/oidc": "^4.0.7",
    "@vercel/sandbox": "^3.9.1",
    "codemirror": "^6.0.2",
    "katex": "^0.19.1",
    "next": "^16.4.5",
    "pg": "^8.16.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.18.6",
    "@types/pg": "^8.15.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "typescript": "^5.9.2"
  },
  "overrides": {
    "@vercel/oidc": "^4.0.7",
    "katex": "$katex"
  }
}
